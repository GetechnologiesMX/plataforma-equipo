# Versiones de las imágenes de qa y prod (en dev no se usa: dev construye sus imágenes en tu máquina).
# Para publicar una imagen nueva: cambia SOLO su etiqueta, haz commit y corre `make build`
# (con .env de qa o prod). make build construye y sube solo las imágenes cuya etiqueta todavía no
# está en el registro; make deploy, en el servidor, baja las de este archivo.
# Una etiqueta ya publicada no se vuelve a construir: cada cambio lleva etiqueta nueva.
# Convención: <versión>-<AAAAMMDD> para Open edX y los MFE; <AAAAMMDD>-<commit del submódulo> para el CMS y Campus.

OPENEDX_IMAGE_TAG=21.0.10-20261029
MFE_IMAGE_TAG=21.0.3-20261029
CAMPUS_CMS_IMAGE_TAG=
CAMPUS_WEB_IMAGE_TAG=

# Open edX, el CMS y Campus son iguales en qa y prod: prod usa la misma imagen que se probó en qa.
# Los MFE no: llevan compilada la dirección de Campus del ambiente, así que su etiqueta termina en
# -qa o -prod (cada ambiente construye la suya).

DOCKER_IMAGE_OPENEDX='{{ CAMPUS_DOCKER_REGISTRY }}/openedx:{{ OPENEDX_IMAGE_TAG }}'
MFE_DOCKER_IMAGE='{{ CAMPUS_DOCKER_REGISTRY }}/openedx-mfe:{{ MFE_IMAGE_TAG }}'
CAMPUS_CMS_DOCKER_IMAGE='{{ CAMPUS_DOCKER_REGISTRY }}/campus-cms:{{ CAMPUS_CMS_IMAGE_TAG }}'
CAMPUS_WEB_DOCKER_IMAGE='{{ CAMPUS_DOCKER_REGISTRY }}/campus-web:{{ CAMPUS_WEB_IMAGE_TAG }}'
