# Configuración de Tutor SIN secretos, compartida por todos los ambientes.
# Lo de cada ambiente (direcciones, imágenes, llaves) va en .env, copia de .env.local, .env.dev, .env.qa o .env.prod;
# .env nunca se sube a Git.
# Formato: CLAVE=valor (una por línea). Se aplica con `tutor config save --set`.
# Los valores se leen como YAML: pon entre comillas simples los que empiezan con # o tienen : o {{
PLATFORM_NAME=Mi Academia
LANGUAGE_CODE=es-419
# Color de botones y links del LMS clásico, Studio y los correos (los MFE usan
# src/front-campus/public/theme/campus-paragon.css): el --pgn-color-primary-base de ese archivo.
INDIGO_PRIMARY_COLOR='#7C6A52'
INDIGO_ENABLE_DARK_TOGGLE=false
# Las tres apuntan al sitio público (Campus) de cada ambiente: CAMPUS_WEB_URL.
COURSE_PAYMENTS_PUBLIC_SITE_URL='{{ CAMPUS_WEB_URL }}'
CAMPUS_CMS_PUBLIC_SITE_URL='{{ CAMPUS_WEB_URL }}'
CAMPUS_MENU_SITE_URL='{{ CAMPUS_WEB_URL }}'
